/* ========== ORIGINAL STYLES FROM ANCHOR (EXACT) ========== */
body,html{margin:0;padding:0;width:100%;height:100%;background:#000;overflow:hidden;font-family:monospace}
#map{height:100%;width:100%;position:absolute;top:0;z-index:1}
#status-bar{display:none;position:fixed;top:10px;left:5%;width:90%;background:rgba(0,0,0,0.9);border:1px solid #FFD700;z-index:3000;padding:10px;text-align:center;color:#FFD700;font-size:12px;box-sizing:border-box;border-radius:30px}
#mode-toggle{position:absolute;top:20px;right:20px;z-index:2000;background:#000;border:2px solid #FFD700;border-radius:30px;display:flex;overflow:hidden}
.mode-btn{padding:8px 16px;background:transparent;border:none;color:#FFD700;font-family:monospace;font-size:12px;cursor:pointer;transition:0.2s}
.mode-btn.active{background:#FFD700;color:#000}
#fab{position:absolute;bottom:30px;right:30px;width:70px;height:70px;background:#000;border:2px solid #FFD700;border-radius:50%;color:#FFD700;font-size:35px;cursor:pointer;z-index:2000;display:flex;align-items:center;justify-content:center;box-shadow:0 0 15px #FFD700;transition:0.2s}
#fab:hover{background:#FFD700;color:#000}
#profile-gear{position:absolute;top:20px;left:20px;width:36px;height:36px;background:#000;border:2px solid #FFD700;border-radius:50%;color:#FFD700;font-size:20px;cursor:pointer;z-index:2000;display:flex;align-items:center;justify-content:center;box-shadow:0 0 10px #FFD700;transition:0.2s}
#profile-gear:hover{background:#FFD700;color:#000}
#heatmap-toggle-btn{position:absolute;top:70px;left:20px;width:36px;height:36px;background:#000;border:2px solid #FFD700;border-radius:50%;color:#FFD700;font-size:18px;cursor:pointer;z-index:2000;display:flex;align-items:center;justify-content:center;box-shadow:0 0 10px #FFD700;transition:all 0.2s}
#heatmap-loading{position:absolute;top:115px;left:70px;background:#000;border:1px solid #FFD700;padding:4px 8px;font-size:10px;color:#FFD700;z-index:2000;display:none;border-radius:20px}
.heatmap-toast{position:fixed;background:#000;border:1px solid #FFD700;color:#FFD700;padding:8px 12px;border-radius:20px;font-size:11px;z-index:10000;max-width:260px;pointer-events:none;box-shadow:0 0 15px rgba(255,215,0,0.3);transition:opacity 0.2s}
#heatmap-panel{position:absolute;top:115px;left:20px;background:rgba(0,0,0,0.9);border:1px solid #FFD700;border-radius:16px;padding:10px;display:none;flex-direction:column;gap:6px;z-index:2000;min-width:180px;max-width:240px;max-height:250px;overflow-y:auto;backdrop-filter:blur(8px)}
.total-count{font-size:13px;color:#FFD700;border-bottom:1px solid #FFD700;padding-bottom:6px;margin-bottom:6px;text-align:center;font-weight:bold}
.heatmap-row{display:flex;align-items:center;gap:10px;cursor:pointer;padding:5px 8px;border-radius:20px;transition:all 0.2s}
.heatmap-row:hover{background:rgba(255,215,0,0.15)}
.heatmap-dot{width:16px;height:16px;border-radius:50%;display:inline-block;box-shadow:0 0 4px currentColor}
.heatmap-label{font-size:12px;color:#FFD700;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.heatmap-count{font-size:11px;color:#aaa;margin-left:auto}
#terminal{display:none;position:fixed;bottom:10px;left:5%;width:90%;background:rgba(0,10,0,0.95);border:1px solid #FFD700;z-index:2000;flex-direction:column;padding:15px;box-sizing:border-box;border-radius:20px;backdrop-filter:blur(4px)}
#inbox-panel{display:none;border:1px solid #FFD700;padding:10px;margin-bottom:10px;max-height:200px;overflow-y:auto;color:#FFD700;border-radius:16px}
#msg-box{height:150px;overflow-y:auto;color:#FFD700;margin-bottom:10px;border:1px solid #332200;padding:5px;display:flex;flex-direction:column;border-radius:16px}
.chat-msg{max-width:80%;padding:8px 12px;margin:4px 0;border-radius:18px;word-wrap:break-word;font-size:13px;line-height:1.4}
.msg-left{align-self:flex-start;background:#111;border:1px solid #FFD700;color:#FFD700;border-radius:18px 18px 18px 4px}
.msg-right{align-self:flex-end;background:#FFD700;color:#000;border-radius:18px 18px 4px 18px}
#oracle-ballot{display:none;color:#FFD700;border:1px solid #FFD700;padding:10px;margin-bottom:10px;background:rgba(255,215,0,0.1);font-size:11px;text-align:center;border-radius:12px}
#sync-panel{display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.95);border:2px solid #FFD700;z-index:5000;padding:30px;text-align:center;color:#FFD700;border-radius:24px}
#rate-panel{display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.95);border:2px solid #FFD700;z-index:5000;padding:30px;text-align:center;color:#FFD700;border-radius:24px}
#nav-hud{display:none;position:fixed;bottom:0;left:0;width:100%;background:rgba(0,10,0,0.95);border-top:2px solid #FFD700;z-index:4000;padding:20px;text-align:center;color:#FFD700;box-sizing:border-box}
.hud-btn{background:transparent;border:1px solid #FFD700;color:#FFD700;padding:12px;margin:10px 5px;cursor:pointer;font-family:monospace;text-transform:uppercase;border-radius:30px;transition:0.2s}
.hud-btn:hover{background:#FFD700;color:#000}
.sync-btn{background:transparent;border:2px solid #FFD700;color:#FFD700;padding:15px 30px;cursor:pointer;font-family:monospace;font-size:16px;margin:10px;border-radius:40px}
.rate-btn{background:transparent;border:2px solid #FFD700;color:#FFD700;padding:15px 25px;cursor:pointer;font-family:monospace;font-size:24px;margin:10px;border-radius:50px}
#profile-panel{display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,10,0,0.97);border:2px solid #FFD700;z-index:6000;padding:20px;color:#FFD700;width:85%;max-width:320px;box-sizing:border-box;border-radius:24px}
#profile-panel label{display:block;margin:10px 0 4px;font-size:12px}
#profile-panel input,#profile-panel select{width:100%;padding:8px;background:#000;border:1px solid #FFD700;color:#FFD700;font-family:monospace;margin-bottom:5px;border-radius:12px}
.profile-save-btn,.profile-close-btn{border-radius:30px}
#intent-panel{display:none;position:fixed;bottom:110px;left:5%;width:90%;background:rgba(0,10,0,0.97);border:2px solid #FFD700;z-index:5000;padding:0;box-sizing:border-box;max-height:60vh;overflow-y:auto;border-radius:20px}
.accordion-section{border-bottom:1px solid #FFD700}
.accordion-header{width:100%;background:transparent;border:none;color:#FFD700;padding:12px 15px;text-align:left;font-family:monospace;font-size:14px;cursor:pointer;display:flex;justify-content:space-between;align-items:center}
.accordion-header:hover{background:rgba(255,215,0,0.05)}
.accordion-body{display:none;padding:0 15px 12px}
.accordion-body.open{display:block}
.btn-row{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.intent-btn{background:transparent;border:1px solid #FFD700;color:#FFD700;padding:8px 12px;cursor:pointer;font-family:monospace;font-size:12px;display:flex;align-items:center;gap:5px;white-space:nowrap;border-radius:30px}
.intent-btn:hover,.intent-btn.selected{background:#FFD700;color:#000}
.intent-btn.custom{border-style:dashed}
.node-type-row{margin:8px 0;display:flex;gap:10px;align-items:center}
.vibe-row{margin:8px 0}
.vibe-option{background:transparent;border:1px solid #FFD700;color:#FFD700;padding:5px 10px;cursor:pointer;font-family:monospace;font-size:11px;margin-right:5px;border-radius:30px}
.vibe-option.selected{background:#FFD700;color:#000}
.custom-input{width:100%;padding:8px;background:#000;border:1px solid #FFD700;color:#FFD700;margin-top:5px;font-family:monospace;font-size:12px;display:none;border-radius:12px}
.done-btn{display:none;margin-top:8px;background:#FFD700;color:#000;border:none;padding:8px 16px;cursor:pointer;font-family:monospace;border-radius:30px}
.close-btn{display:block;width:100%;background:transparent;border:none;border-top:1px solid #f00;color:#f00;padding:12px;text-align:center;font-family:monospace;cursor:pointer;border-radius:0 0 20px 20px}
.inbox-item{display:flex;align-items:center;margin-bottom:8px;padding:8px;border:1px solid #FFD700;border-radius:16px}
.inbox-item .avatar{font-size:28px;margin-right:10px}
.inbox-item .info{flex:1;font-size:12px}
.inbox-item .info .name{color:#FFD700;font-size:14px}
.inbox-item .info .detail{color:#aaa}
.inbox-actions button{margin-left:5px;background:transparent;border:1px solid #FFD700;color:#FFD700;cursor:pointer;padding:5px 10px;border-radius:20px}
#profile-card{display:none;position:fixed;bottom:0;left:0;width:100%;background:rgba(0,10,0,0.97);border-top:2px solid #FFD700;z-index:4500;padding:20px;color:#FFD700;box-sizing:border-box;max-height:55vh;overflow-y:auto;border-radius:20px 20px 0 0}
#profile-card .emoji{font-size:40px;text-align:center}
#profile-card .name{font-size:18px;text-align:center;margin:5px 0}
#profile-card .stats{text-align:center;font-size:12px;color:#aaa;margin-bottom:10px}
#profile-card .row{display:flex;justify-content:space-between;font-size:13px;margin:4px 0}
#profile-card .tags{margin-top:8px;display:flex;flex-wrap:wrap;gap:6px}
#profile-card .tag{background:rgba(255,215,0,0.15);border:1px solid #FFD700;padding:3px 8px;font-size:11px;border-radius:20px}
#profile-card .vibe-section{margin-top:12px;border-top:1px solid #FFD700;padding-top:10px}
#profile-card .vibe-opt{background:transparent;border:1px solid #FFD700;color:#FFD700;padding:8px 15px;cursor:pointer;font-family:monospace;font-size:12px;margin:5px;border-radius:30px}
#profile-card .vibe-opt.selected{background:#FFD700;color:#000}
#profile-card .send-btn{display:block;width:100%;margin-top:15px;background:#FFD700;color:#000;border:none;padding:12px;cursor:pointer;font-family:monospace;font-size:15px;font-weight:bold;border-radius:30px}
#profile-card .close-card{display:block;width:100%;margin-top:8px;background:transparent;border:1px solid #f00;color:#f00;padding:10px;cursor:pointer;font-family:monospace;border-radius:30px}
.node-popup .mapboxgl-popup-content{background:#000!important;border:1px solid #FFD700!important;color:#FFD700!important;font-family:monospace;padding:6px 10px!important;border-radius:8px!important;box-shadow:0 0 10px #FFD700}
.node-popup .mapboxgl-popup-tip{border-top-color:#FFD700!important}
#receipt-overlay{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.95);z-index:9999;justify-content:center;align-items:center;flex-direction:column;color:#FFD700;font-family:monospace}
.receipt-card{border:2px solid #FFD700;padding:25px;max-width:320px;width:90%;text-align:left;font-size:14px;line-height:1.6;background:#000;position:relative;border-radius:24px}
.receipt-card .hash{word-break:break-all;color:#e6b800;font-size:12px}
.receipt-card .ttl{color:#aaa;font-size:11px}
.redacted-bar{background:#FFD700;color:#000;padding:2px 0;margin:5px 0;text-align:center;font-weight:bold;letter-spacing:2px}
